# Copy to .env and load it before starting the server:  set -a; . ./.env; set +a; ./issue-tracker

# Where the server listens.
HOST=127.0.0.1
PORT=23500

# MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27020
MONGODB_DB=issue_tracker

# Address people open in the browser; used for links in notification emails.
PUBLIC_URL=http://127.0.0.1:23500

# Set to true when served over HTTPS, so the session cookie is HTTPS-only.
COOKIE_SECURE=false

# Set to false to stop new sign-ups once your team has accounts.
# The very first account can always be created; it becomes the site admin.
ALLOW_SIGNUP=true

# Outgoing email. Leave SMTP_HOST empty to turn email notifications off.
SMTP_HOST=
# starttls (port 587), tls (port 465) or none.
SMTP_SECURITY=starttls
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Issue Tracker <issues@example.com>
